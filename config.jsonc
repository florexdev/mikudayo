{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "small",
        "source": "arch",
        "width": 20,
        "padding": {
            "right": 2
        },
        "color": {
            "1": "cyan",
            "2": "magenta",
            "3": "blue",
            "4": "cyan",
            "5": "magenta",
            "6": "cyan"
        }
    },

    "display": {
        "separator": "  ",

        "color": {
            "keys": "cyan",
            "title": "magenta"
        },

        "key": {
            "width": 10,
            "type": "icon"
        }
    },

    "modules": [
        {
            "type": "title",
            "format": "{#magenta}{user-name}@{host-name}{#}"
        },

        "separator",

        {
            "type": "os",
            "key": "󰣇 OS",
            "keyColor": "cyan"
        },

        {
            "type": "kernel",
            "key": "󰌽 Kernel",
            "keyColor": "cyan"
        },

        {
            "type": "uptime",
            "key": "󰅐 Uptime",
            "keyColor": "cyan"
        },

        {
            "type": "de",
            "key": "󰧨 DE",
            "keyColor": "magenta"
        },

        {
            "type": "terminal",
            "key": " Term",
            "keyColor": "magenta"
        },

        "break",

        {
            "type": "cpu",
            "key": "󰻠 CPU",
            "keyColor": "blue"
        },

        {
            "type": "gpu",
            "key": "󰍛 GPU",
            "keyColor": "blue"
        },

        {
            "type": "memory",
            "key": "󰍛 RAM",
            "keyColor": "blue"
        },

        {
            "type": "disk",
            "key": "󰋊 Disk",
            "keyColor": "blue"
        }
    ]
}
