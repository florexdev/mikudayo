[general]
# Ekranındaki akıcılığa uygun bar sayısı ve hassasiyet
framerate = 60
bars = 0
bar_width = 2
bar_spacing = 1

[input]
# Ses sunucun muhtemelen PipeWire veya PulseAudio'dur
method = pulse
source = auto

[color]
# Mor tonlarından camgöbeği mavisine uzanan mükemmel bir gradyan
gradient = 1
gradient_color_1 = '#9A5BEE'
gradient_color_2 = '#7A66EE'
gradient_color_3 = '#5B86EE'
gradient_color_4 = '#46C7E2'

[smoothing]
# Çubukların çok daha yumuşak ve tatlı aşağı yukarı oynaması için
monstercat = 1
waves = 0
